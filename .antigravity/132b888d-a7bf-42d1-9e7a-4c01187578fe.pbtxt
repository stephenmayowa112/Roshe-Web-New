      replacement_content: "import Link from \'next/link\';\nimport Image from \'next/image\';\n\nexport default function Home() {\n  return (\n    <div className=\"w-full bg-white flex flex-col items-center\">\n      {/* Hero Section */}\n      <section className=\"w-full max-w-7xl mx-auto mb-16 relative bg-gray-100 min-h-[60vh] flex items-center justify-center overflow-hidden\">\n        <img \n          src=\"/images/home-hero.jpg\" \n          alt=\"Remember Me Hero\" \n          className=\"absolute inset-0 w-full h-full object-cover\"\n        />\n        {/* If image is missing, show a placeholder box */}\n        <div className=\"absolute inset-0 bg-black/20 flex flex-col items-center justify-start pt-16 -z-10 text-center\">\n          <h1 className=\"text-6xl md:text-8xl font-black text-red-500 drop-shadow-lg mb-2\">Remember Me</h1>\n          <p className=\"text-sm md:text-xl font-medium text-white tracking-widest uppercase drop-shadow-md\">A Roshe Studios Animated Short Film</p>\n        </div>\n      </section>\n\n      {/* Cards Section */}\n      <section className=\"w-full max-w-6xl mx-auto px-4 mb-20\">\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n          {/* Card 1 */}\n          <div className=\"flex flex-col group cursor-pointer\">\n            <div className=\"w-full aspect-[4/5] bg-gray-200 relative overflow-hidden\">\n              <img src=\"/images/card-remember-me.jpg\" alt=\"Remember Me\" className=\"absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\" />\n            </div>\n            <div className=\"bg-black text-white p-6 min-h-[140px] flex flex-col justify-between\">\n              <h3 className=\"text-lg font-medium leading-tight mb-4\">Remember Me: A tribute to<br />the fallen soldiers</h3>\n              <p className=\"text-xs font-bold uppercase tracking-widest\">LICENSING</p>\n            </div>\n          </div>\n\n          {/* Card 2 */}\n          <div className=\"flex flex-col group cursor-pointer\">\n            <div className=\"w-full aspect-[4/5] bg-gray-200 relative overflow-hidden\">\n              <img src=\"/images/card-new-age.jpg\" alt=\"New Age\" className=\"absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\" />\n            </div>\n            <div className=\"bg-black text-white p-6 min-h-[140px] flex flex-col justify-between\">\n              <h3 className=\"text-lg font-medium leading-tight mb-4\">New Age: A 3D animated<br />short film</h3>\n              <p className=\"text-xs font-bold uppercase tracking-widest\">Development</p>\n            </div>\n          </div>\n\n          {/* Card 3 */}\n          <div className=\"flex flex-col group cursor-pointer\">\n            <div className=\"w-full aspect-[4/5] bg-gray-200 relative overflow-hidden\">\n              <img src=\"/images/card-seasonlings.jpg\" alt=\"Seasonlings\" className=\"absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\" />\n            </div>\n            <div className=\"bg-black text-white p-6 min-h-[140px] flex flex-col justify-between\">\n              <h3 className=\"text-lg font-medium leading-tight mb-4\">Seasonlings: A 2D animated<br />Cli-fi animated series</h3>\n              <p className=\"text-xs font-bold uppercase tracking-widest\">Development</p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* Screening Banner */}\n      <section className=\"w-full max-w-7xl mx-auto mb-20 relative h-[400px] overflow-hidden flex items-center justify-center\">\n        <img src=\"/images/home-banner-remember-me.jpg\" alt=\"Remember Me Screening\" className=\"absolute inset-0 w-full h-full object-cover\" />\n        <div className=\"relative z-10 flex flex-col items-center justify-center text-center px-4 w-full h-full bg-black/40\">\n          <img src=\"/images/remember-me-logo.png\" alt=\"Remember Me\" className=\"h-20 md:h-28 mb-4 object-contain\" />\n          <h2 className=\"text-white text-xl md:text-3xl font-medium mb-8\">Screening in Cinemas this November</h2>\n          <div className=\"flex flex-wrap gap-4 justify-center\">\n            <button className=\"bg-white text-black hover:bg-gray-100 px-8 py-3 rounded-full font-semibold text-sm uppercase tracking-wide transition-colors\">\n              BOOK TICKETS\n            </button>\n            <button className=\"bg-transparent border border-white text-white hover:bg-white/10 px-8 py-3 rounded-full font-semibold text-sm uppercase tracking-wide transition-colors\">\n              WATCH TRAILER\n            </button>\n          </div>\n        </div>\n      </section>\n\n      {/* Shop Banner */}\n      <section className=\"w-full max-w-7xl mx-auto mb-20 relative h-[400px] overflow-hidden flex items-center\">\n        <img src=\"/images/home-banner-shop.jpg\" alt=\"Shop stories\" className=\"absolute inset-0 w-full h-full object-cover\" />\n        <div className=\"relative z-10 w-full max-w-xl px-12 md:px-20 text-left\">\n          <h2 className=\"text-black text-3xl md:text-5xl font-bold leading-tight mb-8\">\n            Shop the stories you love<br />for you and your family\n          </h2>\n          <button className=\"bg-white text-black hover:bg-gray-100 px-10 py-3 rounded-full font-semibold text-sm uppercase tracking-wide transition-colors shadow-sm\">\n            Shop now\n          </button>\n        </div>\n      </section>\n    </div>\n  );\n}"
