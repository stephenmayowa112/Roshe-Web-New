# Database
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-here"
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Stripe Configuration
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Stripe Price IDs (create these in your Stripe dashboard)
STRIPE_SINGLE_SCHOOL_PRICE_ID="price_single_school_license"
STRIPE_MULTI_SCHOOL_PRICE_ID="price_multi_school_license"

# Email Configuration (optional - for production)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
FROM_EMAIL="noreply@roshestudios.co.uk"

# App Configuration
APP_NAME="Roshe Studios"
APP_URL="http://localhost:3000"
SUPPORT_EMAIL="support@roshestudios.co.uk"

# Development
NODE_ENV="development"