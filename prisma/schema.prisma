// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(SCHOOL_ADMIN)
  
  // Profile information
  title     String?
  phone     String?
  
  // Verification
  emailVerified DateTime?
  verificationToken String?
  
  // Password reset
  resetToken String?
  resetTokenExpiry DateTime?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  school    School?  @relation(fields: [schoolId], references: [id])
  schoolId  String?
  
  // NextAuth relations
  accounts Account[]
  sessions Session[]
  
  @@map("users")
}

model School {
  id          String   @id @default(cuid())
  name        String
  address     String?
  city        String?
  postcode    String?
  country     String   @default("United Kingdom")
  phone       String?
  website     String?
  
  // School details
  type        SchoolType @default(PRIMARY)
  studentCount Int?
  establishedYear Int?
  
  // Contact person
  headTeacher String?
  contactEmail String?
  
  // Settings
  isActive    Boolean  @default(true)
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  users       User[]
  licenses    License[]
  
  @@map("schools")
}

model License {
  id          String      @id @default(cuid())
  type        LicenseType
  status      LicenseStatus @default(ACTIVE)
  
  // Pricing
  amount      Int         // Amount in pence
  currency    String      @default("GBP")
  
  // Validity
  startDate   DateTime    @default(now())
  endDate     DateTime?
  
  // Stripe integration
  stripeCustomerId String?
  stripeSubscriptionId String?
  stripePriceId String?
  
  // Timestamps
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  // Relations
  school      School      @relation(fields: [schoolId], references: [id])
  schoolId    String
  
  payments    Payment[]
  
  @@map("licenses")
}

model Payment {
  id          String        @id @default(cuid())
  amount      Int           // Amount in pence
  currency    String        @default("GBP")
  status      PaymentStatus @default(PENDING)
  
  // Stripe integration
  stripePaymentIntentId String @unique
  stripeCustomerId String?
  
  // Payment details
  paymentMethod String?
  description String?
  
  // Timestamps
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  // Relations
  license     License       @relation(fields: [licenseId], references: [id])
  licenseId   String
  
  @@map("payments")
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Enums
enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
}

enum SchoolType {
  PRIMARY
  SECONDARY
  INDEPENDENT
  ACADEMY
  FREE_SCHOOL
  SPECIAL
  NURSERY
}

enum LicenseType {
  SINGLE_SCHOOL
  MULTI_SCHOOL
  TRIAL
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}