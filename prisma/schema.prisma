// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  name      String?
  role      String   @default("SCHOOL_ADMIN") // SUPER_ADMIN, SCHOOL_ADMIN, TEACHER
  
  // Profile information
  title     String?
  phone     String?
  
  // Verification
  emailVerified DateTime?
  isEmailVerified Boolean @default(false)
  verificationToken String?
  emailVerificationToken String?
  emailVerificationExpires DateTime?
  
  // Password reset
  resetToken String?
  resetTokenExpiry DateTime?
  passwordResetToken String?
  passwordResetExpires DateTime?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  school    School?  @relation(fields: [schoolId], references: [id])
  schoolId  String?
  
  // NextAuth relations
  accounts Account[]
  sessions Session[]
  
  // App relations
  licenses License[]
  payments Payment[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application Models
model School {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("PRIMARY") // PRIMARY, SECONDARY, INDEPENDENT, ACADEMY, FREE_SCHOOL, SPECIAL, NURSERY
  
  // Contact information
  address      String?
  city         String?
  county       String?
  postcode     String?
  country      String   @default("United Kingdom")
  
  // Contact details
  contactEmail String?
  contactPhone String?
  website      String?
  
  // School details
  headTeacher     String?
  studentCount    Int?
  establishedYear Int?
  urn            String? // Unique Reference Number
  ofstedRating   String? // Outstanding, Good, Requires Improvement, Inadequate
  
  // Trust/Multi-Academy information
  trustName   String?
  isPartOfTrust Boolean @default(false)
  
  // Status
  isActive    Boolean  @default(true)
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  users       User[]
  licenses    License[]
  payments    Payment[]
}

model License {
  id          String   @id @default(cuid())
  type        String   // SINGLE_SCHOOL, MULTI_SCHOOL, TRIAL
  status      String   @default("PENDING") // ACTIVE, EXPIRED, CANCELLED, PENDING
  
  // License details
  description String?
  features    String?  // JSON string of included features
  maxUsers    Int?     // Maximum number of users (null = unlimited)
  
  // Pricing
  amount      Int      // Amount in pence/cents
  currency    String   @default("GBP")
  
  // Validity period
  startDate   DateTime?
  endDate     DateTime?
  expiresAt   DateTime?
  
  // Renewal
  autoRenew   Boolean  @default(false)
  renewalDate DateTime?
  
  // Relations
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  userId      String?  // License purchaser
  user        User?    @relation(fields: [userId], references: [id])
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  payments    Payment[]
}

model Payment {
  id                String   @id @default(cuid())
  
  // Stripe information
  stripePaymentIntentId String? @unique
  stripeCustomerId     String?
  stripeSessionId      String?
  
  // Payment details
  amount        Int      // Amount in pence/cents
  currency      String   @default("GBP")
  status        String   @default("PENDING") // PENDING, SUCCEEDED, FAILED, CANCELLED, REFUNDED
  
  // Payment method
  paymentMethod String?  // card, bank_transfer, etc.
  last4         String?  // Last 4 digits of card
  brand         String?  // visa, mastercard, etc.
  
  // Description and metadata
  description   String?
  metadata      String?  // JSON string for additional data
  
  // Failure information
  failureCode   String?
  failureMessage String?
  
  // Refund information
  refundAmount  Int?     // Amount refunded in pence/cents
  refundReason  String?
  refundedAt    DateTime?
  
  // Relations
  schoolId      String?
  school        School?  @relation(fields: [schoolId], references: [id])
  
  licenseId     String?
  license       License? @relation(fields: [licenseId], references: [id])
  
  userId        String?  // User who made the payment
  user          User?    @relation(fields: [userId], references: [id])
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  paidAt        DateTime?
}